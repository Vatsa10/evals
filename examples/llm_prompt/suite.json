{
  "schema_version": 1,
  "name": "llm-order-quantity",
  "mode": "live",
  "trials": 1,
  "target": {"type": "python", "path": "app.py", "timeout_seconds": 180},
  "cases": [
    {"id": "single-item", "input": "Please order one notebook.", "expected_quantity": 1,
