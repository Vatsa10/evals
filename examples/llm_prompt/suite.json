    {"id": "combined-items", "input": "Order two notebooks for me and three more for my team. What is the total notebook quantity?", "expected_quantity": 5,
      "graders": [{"id": "quantity-correct", "type": "custom", "adapter": {"type": "python", "path": "judge.py"}}]},
    {"id": "cancelled-order", "input": "Cancel my notebook order. The quantity should be zero.", "expected_quantity": 0,
      "graders": [{"id": "quantity-correct", "type": "custom", "adapter": {"type": "python", "path": "judge.py"}}]}
  ]
}
